# 开发/测试环境：Python + Java(epubcheck) + chromium（版面回归对比）。交付镜像见根目录 Dockerfile。
FROM python:3.13-slim-trixie

ARG EPUBCHECK_VERSION=5.4.0
RUN apt-get update \
 && apt-get install -y --no-install-recommends default-jre-headless curl unzip chromium fonts-noto-cjk \
 && curl -fsSL -o /tmp/epubcheck.zip \
      https://github.com/w3c/epubcheck/releases/download/v${EPUBCHECK_VERSION}/epubcheck-${EPUBCHECK_VERSION}.zip \
 && unzip -q /tmp/epubcheck.zip -d /opt \
 && mv /opt/epubcheck-${EPUBCHECK_VERSION} /opt/epubcheck \
 && printf '#!/bin/sh\nexec java -jar /opt/epubcheck/epubcheck.jar "$@"\n' > /usr/local/bin/epubcheck \
 && chmod +x /usr/local/bin/epubcheck \
 && rm /tmp/epubcheck.zip && apt-get purge -y curl unzip && apt-get autoremove -y \
 && rm -rf /var/lib/apt/lists/*

# KindleUnpack（PyPI 包 mobi，GPL-3）：把 MOBI/AZW/AZW3 拆成 EPUB。装在独立虚拟环境里、按命令调用，
# 不和本项目的 Python 包混装（kindle.py）
ARG MOBI_VERSION=0.4.1
RUN python -m venv /opt/kindleunpack \
 && /opt/kindleunpack/bin/pip install --no-cache-dir "mobi==${MOBI_VERSION}" \
 && ln -s /opt/kindleunpack/bin/mobiunpack /usr/local/bin/mobiunpack

WORKDIR /app
COPY pyproject.toml ./
RUN pip install --no-cache-dir lxml cssselect tinycss2 fonttools brotli pillow pytest fastapi uvicorn python-multipart httpx "anthropic>=1.17,<2"
ENV PYTHONPATH=/app/src \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8
